{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permiss\u00f5es da janela principal do FRX: n\u00facleo do Tauri, comandos pr\u00f3prios, links externos s\u00f3 para as fontes citadas e para iniciar jogos pela Steam, e di\u00e1logos de abrir/salvar arquivos (importa\u00e7\u00e3o e exporta\u00e7\u00e3o de benchmarks).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        },
        {
          "url": "https://raw.githubusercontent.com/*"
        },
        {
          "url": "https://www.protondb.com/*"
        },
        {
          "url": "https://store.steampowered.com/app/*"
        },
        {
          "url": "https://steamdb.info/app/*"
        },
        {
          "url": "https://openwinecomponents.org/*"
        },
        {
          "url": "steam://rungameid/*"
        },
        {
          "url": "https://www.nvidia.com/en-us/geforce/technologies/dlss/*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
