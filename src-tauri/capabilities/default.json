{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal do FRX: núcleo do Tauri, comandos próprios, links externos só para as fontes citadas e para iniciar jogos pela Steam, e diálogos de abrir/salvar arquivos (importação e exportação de benchmarks).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        },
        {
          "url": "https://raw.githubusercontent.com/*"
        },
        {
          "url": "https://www.protondb.com/*"
        },
        {
          "url": "https://store.steampowered.com/app/*"
        },
        {
          "url": "https://steamdb.info/app/*"
        },
        {
          "url": "https://openwinecomponents.org/*"
        },
        {
          "url": "steam://rungameid/*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
